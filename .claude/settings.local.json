{
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(Get-ChildItem -Path . -Depth 2)",
      "Bash(Select-Object FullName)",
      "Bash(grep -r \"from src.agents\" . --include=\"*.py\" --not -path \"./.venv/*\")",
      "Bash(grep -E \"\\\\.py$\")",
      "Bash(python3 -c \"from src.agents.cv_writer import call_cv_agent\")",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(xargs -r git rm --cached)",
      "Bash(.venv/Scripts/python.exe -c \"import jobsearch_agent; print\\('pkg ok, version', jobsearch_agent.__version__\\)\")",
      "Bash(.venv/Scripts/python.exe -c ' *)",
      "Bash(awk '{print $1}')",
      "Bash(docker --version)",
      "Bash(docker info *)",
      "PowerShell(Test-Path *)",
      "Bash(.venv/Scripts/python.exe -c \"from jobsearch_agent.api.app import app; print\\('ok'\\)\")",
      "Bash(.venv/Scripts/python.exe -m uvicorn jobsearch_agent.api.app:app --host 127.0.0.1 --port 8765 --log-level warning)",
      "Bash(curl -s -o /dev/null -w \"GET /  -> HTTP %{http_code}  size=%{size_download} content-type=%{content_type}\\\\n\" http://127.0.0.1:8765/)",
      "Bash(curl -s -o /dev/null -w \"GET /health -> HTTP %{http_code}  body=\" http://127.0.0.1:8765/health)",
      "Bash(curl -s http://127.0.0.1:8765/health)",
      "Bash(curl -s -o /dev/null -w \"GET /docs -> HTTP %{http_code}\\\\n\" http://127.0.0.1:8765/docs)",
      "Bash(curl -s -o /dev/null -w \"GET /ui/index.html -> HTTP %{http_code}\\\\n\" http://127.0.0.1:8765/ui/index.html)",
      "Bash(curl -s http://127.0.0.1:8765/)",
      "Bash(curl -s -o /dev/null -w \"GET /jobs/stats -> HTTP %{http_code}\\\\n\" http://127.0.0.1:8765/jobs/stats)",
      "Bash(curl -s -o /dev/null -w \"GET /search/history -> HTTP %{http_code}\\\\n\" http://127.0.0.1:8765/search/history)",
      "Bash(taskkill //F //FI \"WINDOWTITLE eq *uvicorn*\")",
      "Bash(awk '{print $2}')",
      "Bash(xargs -r kill)"
    ]
  }
